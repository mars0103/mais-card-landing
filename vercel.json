{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/termos", "destination": "/termos/index.html" },
    { "source": "/privacidade", "destination": "/privacidade/index.html" },
    { "source": "/termos/cartao", "destination": "/termos/cartao/index.html" },
    { "source": "/termos/carteira", "destination": "/termos/carteira/index.html" },
    { "source": "/termos/lgpd", "destination": "/termos/lgpd/index.html" },
    { "source": "/termos/comunicacoes", "destination": "/termos/comunicacoes/index.html" },
    { "source": "/excluir-conta", "destination": "/excluir-conta/index.html" },
    { "source": "/trocar-coins", "destination": "/trocar-coins/index.html" },
    { "source": "/saque", "destination": "/saque/index.html" },
    { "source": "/conta", "destination": "/conta/index.html" },
    { "source": "/transferencias", "destination": "/transferencias/index.html" },
    { "source": "/adicionar-saldo", "destination": "/adicionar-saldo/index.html" },
    { "source": "/link-pagamento", "destination": "/link-pagamento/index.html" },
    { "source": "/cofre", "destination": "/cofre/index.html" },
    { "source": "/recarga", "destination": "/recarga/index.html" },
    { "source": "/boletos", "destination": "/boletos/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(models|textures|img|brand)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
